<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details">
        <field
            name="id"
            type="number"
            label="JGLOBAL_FIELD_ID_LABEL"
            description="JGLOBAL_FIELD_ID_DESC"
            class="readonly"
            readonly="true"
            filter="unset"
        />

        <field
            name="titulo"
            type="text"
            label="COM_SERVICOS_FIELD_TITLE_LABEL"
            description="COM_SERVICOS_FIELD_TITLE_DESC"
            size="40"
            required="true"
            filter="string"
        />

        <field
            name="alias"
            type="text"
            label="JFIELD_ALIAS_LABEL"
            description="JFIELD_ALIAS_DESC"
            hint="JFIELD_ALIAS_PLACEHOLDER"
            size="40"
        />

        <field
            name="o_que_e"
            type="editor"
            label="COM_SERVICOS_FIELD_O_QUE_E_LABEL"
            description="COM_SERVICOS_FIELD_O_QUE_E_DESC"
            filter="JComponentHelper::filterText"
            buttons="true"
        />

        <field
            name="quem_pode_utilizar"
            type="editor"
            label="COM_SERVICOS_FIELD_QUEM_PODE_UTILIZAR_LABEL"
            description="COM_SERVICOS_FIELD_QUEM_PODE_UTILIZAR_DESC"
            filter="JComponentHelper::filterText"
            buttons="true"
        />

        <field
            name="etapas"
            type="editor"
            label="COM_SERVICOS_FIELD_ETAPAS_LABEL"
            description="COM_SERVICOS_FIELD_ETAPAS_DESC"
            filter="JComponentHelper::filterText"
            buttons="true"
        />

        <field
            name="outras_informacoes"
            type="editor"
            label="COM_SERVICOS_FIELD_OUTRAS_INFORMACOES_LABEL"
            description="COM_SERVICOS_FIELD_OUTRAS_INFORMACOES_DESC"
            filter="JComponentHelper::filterText"
            buttons="true"
        />

        <field
            name="tags"
            type="text"
            label="COM_SERVICOS_FIELD_TAGS_LABEL"
            description="COM_SERVICOS_FIELD_TAGS_DESC"
            hint="COM_SERVICOS_FIELD_TAGS_HINT"
            size="40"
        />

        <field
            name="categoria"
            type="list"
            label="COM_SERVICOS_FIELD_CATEGORIA_LABEL"
            description="COM_SERVICOS_FIELD_CATEGORIA_DESC"
            >
            <option value="">COM_SERVICOS_SELECT_CATEGORIA</option>
            <option value="Meio Ambiente e Clima">Meio Ambiente e Clima</option>
            <option value="Trabalho, Emprego e Previdência">Trabalho, Emprego e Previdência</option>
            <option value="Agricultura e Pecuária">Agricultura e Pecuária</option>
            <option value="Justiça e Segurança">Justiça e Segurança</option>
            <option value="Educação e Pesquisa">Educação e Pesquisa</option>
            <option value="Saúde">Saúde</option>
            <option value="Economia e Finanças">Economia e Finanças</option>
            <option value="Cidadania e Direitos">Cidadania e Direitos</option>
            <option value="Defesa e Segurança Nacional">Defesa e Segurança Nacional</option>
        </field>

        <field
            name="tipo_destaque"
            type="list"
            label="COM_SERVICOS_FIELD_TIPO_DESTAQUE_LABEL"
            description="COM_SERVICOS_FIELD_TIPO_DESTAQUE_DESC"
            >
            <option value="">COM_SERVICOS_SELECT_TIPO_DESTAQUE</option>
            <option value="recomendado">COM_SERVICOS_TIPO_RECOMENDADO</option>
            <option value="mais_acessado">COM_SERVICOS_TIPO_MAIS_ACESSADO</option>
            <option value="destaque">COM_SERVICOS_TIPO_DESTAQUE</option>
        </field>

        <field
            name="acessos"
            type="number"
            label="COM_SERVICOS_FIELD_ACESSOS_LABEL"
            description="COM_SERVICOS_FIELD_ACESSOS_DESC"
            default="0"
            min="0"
        />

        <field
            name="publicado"
            type="list"
            label="JSTATUS"
            description="JFIELD_PUBLISHED_DESC"
            class="custom-select-color-state"
            size="1"
            default="1"
            >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="data_criacao"
            type="calendar"
            label="JGLOBAL_FIELD_CREATED_LABEL"
            description="COM_SERVICOS_FIELD_CREATED_DESC"
            size="22"
            format="%Y-%m-%d %H:%M:%S"
            filter="user_utc"
        />

        <field
            name="data_modificacao"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            description="COM_SERVICOS_FIELD_MODIFIED_DESC"
            class="readonly"
            size="22"
            readonly="true"
            format="%Y-%m-%d %H:%M:%S"
            filter="user_utc"
        />

        <field
            name="created_by"
            type="user"
            label="JGLOBAL_FIELD_CREATED_BY_LABEL"
            description="COM_SERVICOS_FIELD_CREATED_BY_DESC"
        />

        <field
            name="modified_by"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            description="COM_SERVICOS_FIELD_MODIFIED_BY_DESC"
            class="readonly"
            readonly="true"
            filter="unset"
        />
    </fieldset>
</form>