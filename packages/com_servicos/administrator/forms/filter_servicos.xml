<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="COM_SERVICOS_FILTER_SEARCH_LABEL"
            description="COM_SERVICOS_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />

        <field
            name="published"
            type="status"
            label="JOPTION_SELECT_PUBLISHED"
            description="JOPTION_SELECT_PUBLISHED_DESC"
            onchange="this.form.submit();"
            >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field
            name="categoria"
            type="list"
            label="COM_SERVICOS_FILTER_CATEGORIA_LABEL"
            description="COM_SERVICOS_FILTER_CATEGORIA_DESC"
            onchange="this.form.submit();"
            >
            <option value="">COM_SERVICOS_SELECT_CATEGORIA</option>
            <option value="Meio Ambiente e Clima">Meio Ambiente e Clima</option>
            <option value="Trabalho, Emprego e Previdência">Trabalho, Emprego e Previdência</option>
            <option value="Agricultura e Pecuária">Agricultura e Pecuária</option>
            <option value="Justiça e Segurança">Justiça e Segurança</option>
            <option value="Educação e Pesquisa">Educação e Pesquisa</option>
            <option value="Saúde">Saúde</option>
            <option value="Economia e Finanças">Economia e Finanças</option>
            <option value="Cidadania e Direitos">Cidadania e Direitos</option>
            <option value="Defesa e Segurança Nacional">Defesa e Segurança Nacional</option>
        </field>

        <field
            name="tipo_destaque"
            type="list"
            label="COM_SERVICOS_FILTER_TIPO_DESTAQUE_LABEL"
            description="COM_SERVICOS_FILTER_TIPO_DESTAQUE_DESC"
            onchange="this.form.submit();"
            >
            <option value="">COM_SERVICOS_SELECT_TIPO_DESTAQUE</option>
            <option value="recomendado">COM_SERVICOS_TIPO_RECOMENDADO</option>
            <option value="mais_acessado">COM_SERVICOS_TIPO_MAIS_ACESSADO</option>
            <option value="destaque">COM_SERVICOS_TIPO_DESTAQUE</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="COM_SERVICOS_LIST_FULL_ORDERING"
            description="COM_SERVICOS_LIST_FULL_ORDERING_DESC"
            onchange="this.form.submit();"
            default="a.ordering ASC"
            >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="a.publicado ASC">JSTATUS_ASC</option>
            <option value="a.publicado DESC">JSTATUS_DESC</option>
            <option value="a.titulo ASC">COM_SERVICOS_HEADING_TITLE_ASC</option>
            <option value="a.titulo DESC">COM_SERVICOS_HEADING_TITLE_DESC</option>
            <option value="a.categoria ASC">COM_SERVICOS_HEADING_CATEGORIA_ASC</option>
            <option value="a.categoria DESC">COM_SERVICOS_HEADING_CATEGORIA_DESC</option>
            <option value="a.acessos ASC">COM_SERVICOS_HEADING_ACESSOS_ASC</option>
            <option value="a.acessos DESC">COM_SERVICOS_HEADING_ACESSOS_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            class="input-mini"
            default="25"
            label="COM_SERVICOS_LIST_LIMIT"
            description="COM_SERVICOS_LIST_LIMIT_DESC"
            onchange="this.form.submit();"
        />
    </fields>
</form>