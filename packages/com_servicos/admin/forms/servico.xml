<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details" label="Detalhes">
        <field name="id" type="number" default="0" readonly="true" class="readonly" label="ID"/>
        <field name="title" type="text" label="Título do Serviço" required="true" class="input-xxlarge"/>
        <field name="alias" type="text" label="Alias"/>
        <field name="icon" type="list" label="Ícone" description="Escolha um ícone do GovtBR DS">
            <option value="">Selecione...</option>
            <option value="fas fa-graduation-cap">Educação (Capelo)</option>
            <option value="fas fa-briefcase">Trabalho (Maleta)</option>
            <option value="fas fa-university">Finanças (Banco)</option>
            <option value="fas fa-heartbeat">Saúde (Coração)</option>
            <option value="fas fa-leaf">Ambiente (Folha)</option>
            <option value="fas fa-tractor">Agricultura (Trator)</option>
            <option value="fas fa-gavel">Justiça (Martelo)</option>
            <option value="fas fa-paw">Pet (Pata)</option>
            <option value="fas fa-file-invoice-dollar">Imposto (Fatura)</option>
            <option value="fas fa-signature">Assinatura (Caneta)</option>
            <option value="fas fa-id-card">Identidade (Cartão)</option>
            <option value="fas fa-car">Transporte (Carro)</option>
            <option value="fas fa-home">Habitação (Casa)</option>
        </field>
        <field name="featured" type="radio" label="Destaque Home?" default="0" class="btn-group btn-group-yesno">
            <option value="1">Sim</option><option value="0">Não</option>
        </field>
        <field name="catid" type="category" extension="com_servicos" label="Categoria" required="true"/>
        <field name="introtext" type="editor" label="O que é?" height="200" buttons="true"/>
        <field name="target_audience" type="editor" label="Quem pode utilizar?" height="150" buttons="true"/>
        <field name="steps" type="editor" label="Etapas" height="300" buttons="true"/>
        <field name="other_info" type="editor" label="Outras Informações" height="150" buttons="true"/>
        <field name="tags" type="tag" label="Tags" multiple="true" mode="nested"/>
        <field name="state" type="list" label="Estado" default="1">
            <option value="1">Publicado</option><option value="0">Despublicado</option><option value="-2">Lixeira</option>
        </field>
    </fieldset>
</form>