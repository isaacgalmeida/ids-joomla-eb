<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_servicos</name>
    <version>1.0.2</version>
    <description>Catálogo de Serviços Públicos - Padrão GOV.BR</description>
    <author>Joomla Dev</author>
    <creationDate>December 2025</creationDate>
    <copyright>Copyright (C) 2025. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <namespace path="src">Joomla\Component\Servicos</namespace>
    <files folder="site/">
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <scriptfile>script.php</scriptfile>
    <administration>
        <menu img="class:briefcase">Serviços GOV.BR</menu>
        <submenu>
            <menu link="option=com_servicos&amp;view=servicos">Serviços</menu>
            <menu link="option=com_categories&amp;view=categories&amp;extension=com_servicos">Categorias</menu>
        </submenu>
        <files folder="admin/">
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>sql</folder>
            <folder>services</folder>
            <folder>forms</folder>
            <folder>language</folder>
            <file>access.xml</file>
            <file>config.xml</file>
        </files>
    </administration>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>
</extension>